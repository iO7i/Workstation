{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "type": "object",
  "additionalProperties": false,
  "properties": {
    "session_id": {
      "anyOf": [
        {
          "type": "string",
          "minLength": 1,
          "maxLength": 64,
          "pattern": "^[A-Za-z0-9_.-]+$"
        },
        {
          "type": "null"
        }
      ]
    },
    "completed": {
      "type": "array",
      "items": {
        "type": "string",
        "maxLength": 1024
      },
      "maxItems": 32
    },
    "remaining": {
      "type": "array",
      "items": {
        "type": "string",
        "maxLength": 1024
      },
      "maxItems": 32
    },
    "blockers": {
      "type": "array",
      "items": {
        "type": "string",
        "maxLength": 1024
      },
      "maxItems": 32
    },
    "tests": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "properties": {
          "name": {
            "type": "string",
            "maxLength": 256
          },
          "result": {
            "type": "string",
            "maxLength": 256
          },
          "evidence": {
            "$ref": "#/$defs/Evidence"
          }
        },
        "required": [
          "name",
          "result",
          "evidence"
        ]
      },
      "maxItems": 16
    },
    "decision_ids": {
      "type": "array",
      "items": {
        "type": "string",
        "minLength": 1,
        "maxLength": 64,
        "pattern": "^[A-Za-z0-9_.-]+$"
      },
      "maxItems": 32
    },
    "resource_ids": {
      "type": "array",
      "items": {
        "type": "string",
        "minLength": 1,
        "maxLength": 64,
        "pattern": "^[A-Za-z0-9_.-]+$"
      },
      "maxItems": 32
    }
  },
  "required": [
    "completed",
    "remaining",
    "blockers",
    "tests",
    "decision_ids",
    "resource_ids"
  ],
  "$defs": {
    "Evidence": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "kind": {
          "type": "string",
          "enum": [
            "observed",
            "agent_reported",
            "inferred",
            "user_approved",
            "provider_verified",
            "unknown"
          ]
        },
        "source": {
          "type": "string",
          "maxLength": 256
        },
        "at": {
          "type": "integer",
          "minimum": 0,
          "maximum": 253402300799
        },
        "coverage": {
          "type": "string",
          "enum": [
            "complete",
            "partial",
            "denied",
            "unsupported",
            "timed_out"
          ]
        }
      },
      "required": [
        "kind",
        "source",
        "at",
        "coverage"
      ]
    },
    "Focus": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "needs": {
          "type": "array",
          "items": {
            "type": "string",
            "maxLength": 1024
          },
          "maxItems": 32
        },
        "free_only": {
          "type": "boolean"
        },
        "local_only": {
          "type": "boolean"
        },
        "platform": {
          "type": "string",
          "enum": [
            "windows",
            "linux",
            "macos"
          ]
        },
        "existing": {
          "type": "array",
          "items": {
            "type": "string",
            "maxLength": 1024
          },
          "maxItems": 32
        },
        "blocked": {
          "type": "array",
          "items": {
            "type": "string",
            "maxLength": 1024
          },
          "maxItems": 32
        },
        "evidence_ref": {
          "type": "string",
          "maxLength": 256
        }
      },
      "required": [
        "needs",
        "free_only",
        "local_only",
        "platform",
        "existing",
        "blocked",
        "evidence_ref"
      ]
    },
    "WorkState": {
      "type": "string",
      "enum": [
        "planned",
        "active",
        "paused",
        "blocked",
        "review",
        "done",
        "cancelled"
      ]
    },
    "ResourceKind": {
      "type": "string",
      "enum": [
        "service",
        "endpoint",
        "deployment",
        "database",
        "runbook",
        "secret_reference",
        "reference"
      ]
    },
    "economics::PreferenceProfile": {
      "type": "string",
      "enum": [
        "maximum_intelligence",
        "balanced",
        "stretch",
        "economy"
      ]
    },
    "QuotaSample": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "id": {
          "type": "string",
          "minLength": 1,
          "maxLength": 64,
          "pattern": "^[A-Za-z0-9_.-]+$"
        },
        "provider": {
          "type": "string",
          "minLength": 1,
          "maxLength": 64,
          "pattern": "^[A-Za-z0-9_.-]+$"
        },
        "account_alias": {
          "type": "string",
          "minLength": 1,
          "maxLength": 64,
          "pattern": "^[A-Za-z0-9_.-]+$"
        },
        "bucket": {
          "type": "string",
          "minLength": 1,
          "maxLength": 64,
          "pattern": "^[A-Za-z0-9_.-]+$"
        },
        "meter": {
          "type": "string",
          "enum": [
            "context",
            "subscription",
            "dollars"
          ]
        },
        "unit": {
          "type": "string",
          "enum": [
            "percent",
            "credits",
            "tokens",
            "usd"
          ]
        },
        "window_id": {
          "type": "string",
          "maxLength": 256
        },
        "used": {
          "type": "number",
          "minimum": 0
        },
        "limit": {
          "anyOf": [
            {
              "type": "number",
              "minimum": 0
            },
            {
              "type": "null"
            }
          ]
        },
        "reset_at": {
          "anyOf": [
            {
              "type": "integer",
              "minimum": 0,
              "maximum": 253402300799
            },
            {
              "type": "null"
            }
          ]
        },
        "observed_at": {
          "type": "integer",
          "minimum": 0,
          "maximum": 253402300799
        },
        "precision": {
          "type": "string",
          "enum": [
            "exact",
            "estimated",
            "provider_reported"
          ]
        },
        "evidence": {
          "$ref": "#/$defs/Evidence"
        }
      },
      "required": [
        "id",
        "provider",
        "account_alias",
        "bucket",
        "meter",
        "unit",
        "window_id",
        "used",
        "observed_at",
        "precision",
        "evidence"
      ]
    },
    "Feedback": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "id": {
          "type": "string",
          "minLength": 1,
          "maxLength": 64,
          "pattern": "^[A-Za-z0-9_.-]+$"
        },
        "project_id": {
          "type": "string",
          "minLength": 1,
          "maxLength": 64,
          "pattern": "^[A-Za-z0-9_.-]+$"
        },
        "resource_id": {
          "type": "string",
          "minLength": 1,
          "maxLength": 64,
          "pattern": "^[A-Za-z0-9_.-]+$"
        },
        "need": {
          "type": "string",
          "minLength": 1,
          "maxLength": 64,
          "pattern": "^[A-Za-z0-9_.-]+$"
        },
        "disposition": {
          "type": "string",
          "enum": [
            "saved",
            "dismissed",
            "snoozed",
            "evaluated",
            "adopted"
          ]
        },
        "until": {
          "anyOf": [
            {
              "type": "integer",
              "minimum": 0,
              "maximum": 253402300799
            },
            {
              "type": "null"
            }
          ]
        },
        "outcome": {
          "type": "string",
          "enum": [
            "not_recorded",
            "useful",
            "not_useful",
            "inconclusive"
          ]
        },
        "evidence_ref": {
          "anyOf": [
            {
              "type": "string",
              "maxLength": 256
            },
            {
              "type": "null"
            }
          ]
        },
        "revision": {
          "anyOf": [
            {
              "type": "string",
              "maxLength": 128
            },
            {
              "type": "null"
            }
          ]
        },
        "recorded_at": {
          "type": "integer",
          "minimum": 0,
          "maximum": 253402300799
        }
      },
      "required": [
        "id",
        "project_id",
        "resource_id",
        "need",
        "disposition",
        "outcome",
        "recorded_at"
      ]
    },
    "Capability": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "id": {
          "type": "string",
          "minLength": 1,
          "maxLength": 64,
          "pattern": "^[A-Za-z0-9_.-]+$"
        },
        "title": {
          "type": "string",
          "maxLength": 128
        },
        "kind": {
          "type": "string",
          "enum": [
            "existing_capability",
            "tool",
            "integration",
            "mcp_server",
            "skill",
            "workflow",
            "documentation",
            "reference_implementation",
            "dataset",
            "benchmark"
          ]
        },
        "source": {
          "type": "string",
          "maxLength": 2048
        },
        "needs": {
          "type": "array",
          "items": {
            "type": "string",
            "maxLength": 1024
          },
          "maxItems": 32
        },
        "platforms": {
          "type": "array",
          "items": {
            "type": "string",
            "enum": [
              "windows",
              "linux",
              "macos",
              "platform_neutral"
            ]
          },
          "maxItems": 4
        },
        "cost": {
          "type": "string",
          "enum": [
            "free",
            "paid",
            "unknown",
            "not_applicable"
          ]
        },
        "privacy": {
          "type": "string",
          "enum": [
            "local",
            "external",
            "unknown"
          ]
        },
        "equivalence": {
          "anyOf": [
            {
              "type": "string",
              "maxLength": 128
            },
            {
              "type": "null"
            }
          ]
        },
        "purpose": {
          "type": "string",
          "maxLength": 600
        },
        "limitations": {
          "type": "array",
          "items": {
            "type": "string",
            "maxLength": 1024
          },
          "maxItems": 32
        },
        "review_status": {
          "type": "string",
          "enum": [
            "reviewed",
            "unverified",
            "rejected"
          ]
        },
        "review_revision": {
          "type": "string",
          "maxLength": 128
        },
        "reviewed_at": {
          "type": "integer",
          "minimum": 0,
          "maximum": 253402300799
        },
        "fresh_for_seconds": {
          "type": "integer",
          "minimum": 1,
          "maximum": 31536000
        },
        "license_scope": {
          "type": "string",
          "maxLength": 400
        },
        "adoption_mode": {
          "const": "reference_only"
        }
      },
      "required": [
        "id",
        "title",
        "kind",
        "source",
        "needs",
        "platforms",
        "cost",
        "privacy",
        "purpose",
        "limitations",
        "review_status",
        "review_revision",
        "reviewed_at",
        "fresh_for_seconds",
        "license_scope",
        "adoption_mode"
      ]
    },
    "CandidateInput": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "title": {
          "type": "string",
          "maxLength": 128
        },
        "kind": {
          "type": "string",
          "enum": [
            "existing_capability",
            "tool",
            "integration",
            "mcp_server",
            "skill",
            "workflow",
            "documentation",
            "reference_implementation",
            "dataset",
            "benchmark"
          ]
        },
        "source": {
          "type": "string",
          "maxLength": 2048
        },
        "needs": {
          "type": "array",
          "items": {
            "type": "string",
            "maxLength": 1024
          },
          "maxItems": 32
        },
        "purpose": {
          "type": "string",
          "maxLength": 600
        },
        "limitations": {
          "type": "array",
          "items": {
            "type": "string",
            "maxLength": 1024
          },
          "maxItems": 32
        }
      },
      "required": [
        "title",
        "kind",
        "source",
        "needs",
        "purpose",
        "limitations"
      ]
    },
    "RepairPlan": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "id": {
          "type": "string",
          "minLength": 1,
          "maxLength": 64,
          "pattern": "^[A-Za-z0-9_.-]+$"
        },
        "project_id": {
          "type": "string",
          "minLength": 1,
          "maxLength": 64,
          "pattern": "^[A-Za-z0-9_.-]+$"
        },
        "policy_version": {
          "type": "string",
          "maxLength": 128
        },
        "action": {
          "type": "string",
          "enum": [
            "docker_runtime_quarantine",
            "codex_attachment_registry_reset"
          ]
        },
        "created_at": {
          "type": "integer",
          "minimum": 0,
          "maximum": 253402300799
        },
        "expires_at": {
          "type": "integer",
          "minimum": 0,
          "maximum": 253402300799
        },
        "target": {
          "type": "object",
          "additionalProperties": false,
          "properties": {
            "object_id": {
              "type": "string",
              "minLength": 1,
              "maxLength": 64,
              "pattern": "^[A-Za-z0-9_.-]+$"
            },
            "identity_digest": {
              "type": "string",
              "maxLength": 256
            },
            "coverage": {
              "type": "string",
              "enum": [
                "complete",
                "partial",
                "denied",
                "unsupported",
                "timed_out"
              ]
            },
            "active_dependencies": {
              "type": "boolean"
            }
          },
          "required": [
            "object_id",
            "identity_digest",
            "coverage",
            "active_dependencies"
          ]
        },
        "evidence_refs": {
          "type": "array",
          "items": {
            "type": "string",
            "maxLength": 1024
          },
          "maxItems": 32
        },
        "backup_required": {
          "const": true
        }
      },
      "required": [
        "id",
        "project_id",
        "policy_version",
        "action",
        "created_at",
        "expires_at",
        "target",
        "evidence_refs",
        "backup_required"
      ]
    }
  }
}

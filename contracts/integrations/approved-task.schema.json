{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "Workstation 0.3 approved-task \u2014 authoring contract; runtime validation is also required",
  "type": "object",
  "additionalProperties": false,
  "properties": {
    "id": {
      "type": "string",
      "minLength": 1,
      "maxLength": 64,
      "pattern": "^[A-Za-z0-9_.-]+$"
    },
    "project_id": {
      "type": "string",
      "minLength": 1,
      "maxLength": 64,
      "pattern": "^[A-Za-z0-9_.-]+$"
    },
    "environment": {
      "type": "string",
      "minLength": 1,
      "maxLength": 64,
      "pattern": "^[A-Za-z0-9_.-]+$"
    },
    "executable": {
      "type": "string",
      "minLength": 1,
      "maxLength": 32700
    },
    "executable_sha256": {
      "type": "string",
      "pattern": "^[0-9a-fA-F]{64}$"
    },
    "cwd": {
      "type": "string",
      "minLength": 1,
      "maxLength": 32700
    },
    "directory_identity": {
      "type": "string",
      "minLength": 1,
      "maxLength": 256
    },
    "args": {
      "type": "array",
      "items": {
        "type": "string",
        "maxLength": 2048
      },
      "maxItems": 64
    },
    "script_pins": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "properties": {
          "path": {
            "type": "string",
            "minLength": 1,
            "maxLength": 32700
          },
          "sha256": {
            "type": "string",
            "pattern": "^[0-9a-fA-F]{64}$"
          }
        },
        "required": [
          "path",
          "sha256"
        ]
      },
      "maxItems": 32
    },
    "secret_bindings": {
      "type": "object",
      "maxProperties": 32,
      "propertyNames": {
        "type": "string",
        "pattern": "^[A-Z0-9_]+$"
      },
      "additionalProperties": {
        "type": "string",
        "minLength": 1,
        "maxLength": 64,
        "pattern": "^[A-Za-z0-9_.-]+$"
      }
    },
    "timeout_seconds": {
      "type": "integer",
      "minimum": 1,
      "maximum": 3600
    },
    "output_policy": {
      "const": "discard"
    }
  },
  "required": [
    "id",
    "project_id",
    "environment",
    "executable",
    "executable_sha256",
    "cwd",
    "directory_identity",
    "args",
    "script_pins",
    "secret_bindings",
    "timeout_seconds",
    "output_policy"
  ]
}

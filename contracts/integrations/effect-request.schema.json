{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "Workstation 0.4 effect-request \u2014 authoring contract; runtime validation is also required",
  "oneOf": [
    {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "operation": {
          "const": "query"
        },
        "integration_id": {
          "type": "string",
          "minLength": 1,
          "maxLength": 64,
          "pattern": "^[A-Za-z0-9_.-]+$"
        },
        "query": {
          "type": "string",
          "enum": [
            "codex_quota",
            "codex_threads",
            "docker_local_engine",
            "version",
            "copilot_quota",
            "copilot_models",
            "vendor_sessions",
            "protocol_health",
            "worktrunk_list"
          ]
        }
      },
      "required": [
        "operation",
        "integration_id",
        "query"
      ]
    },
    {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "operation": {
          "const": "task"
        },
        "task_id": {
          "type": "string",
          "minLength": 1,
          "maxLength": 64,
          "pattern": "^[A-Za-z0-9_.-]+$"
        }
      },
      "required": [
        "operation",
        "task_id"
      ]
    },
    {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "operation": {
          "const": "continue"
        },
        "integration_id": {
          "type": "string",
          "minLength": 1,
          "maxLength": 64,
          "pattern": "^[A-Za-z0-9_.-]+$"
        },
        "checkpoint_id": {
          "type": "string",
          "minLength": 1,
          "maxLength": 64,
          "pattern": "^[A-Za-z0-9_.-]+$"
        },
        "resume_external_id": {
          "anyOf": [
            {
              "type": "string",
              "minLength": 1,
              "maxLength": 256
            },
            {
              "type": "null"
            }
          ]
        },
        "permission_mode": {
          "type": "string",
          "enum": [
            "read_only",
            "allow_once"
          ]
        },
        "timeout_seconds": {
          "type": "integer",
          "minimum": 1,
          "maximum": 3600
        }
      },
      "required": [
        "operation",
        "integration_id",
        "checkpoint_id",
        "resume_external_id",
        "permission_mode",
        "timeout_seconds"
      ]
    },
    {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "operation": {
          "const": "billing"
        },
        "provider": {
          "type": "string",
          "enum": [
            "open_ai_costs",
            "anthropic_costs"
          ]
        },
        "credential_resource_id": {
          "type": "string",
          "minLength": 1,
          "maxLength": 64,
          "pattern": "^[A-Za-z0-9_.-]+$"
        },
        "account_alias": {
          "type": "string",
          "minLength": 1,
          "maxLength": 64,
          "pattern": "^[A-Za-z0-9_.-]+$"
        },
        "start_time": {
          "type": "integer",
          "minimum": 0
        },
        "end_time": {
          "type": "integer",
          "minimum": 0
        }
      },
      "required": [
        "operation",
        "provider",
        "credential_resource_id",
        "account_alias",
        "start_time",
        "end_time"
      ]
    },
    {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "operation": {
          "const": "endpoint"
        },
        "resource_id": {
          "type": "string",
          "minLength": 1,
          "maxLength": 64,
          "pattern": "^[A-Za-z0-9_.-]+$"
        }
      },
      "required": [
        "operation",
        "resource_id"
      ]
    },
    {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "operation": {
          "const": "repair"
        },
        "kind": {
          "type": "string",
          "enum": [
            "codex_attachment_registry",
            "docker_runtime",
            "docker_secrets_runtime"
          ]
        },
        "root": {
          "type": "string",
          "minLength": 1,
          "maxLength": 32700
        },
        "error_file": {
          "type": "string",
          "minLength": 1,
          "maxLength": 32700
        },
        "source_version": {
          "type": "string",
          "minLength": 1,
          "maxLength": 128
        }
      },
      "required": [
        "operation",
        "kind",
        "root",
        "error_file",
        "source_version"
      ]
    },
    {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "operation": {
          "const": "repair_undo"
        },
        "execution_id": {
          "type": "string",
          "minLength": 1,
          "maxLength": 64,
          "pattern": "^[A-Za-z0-9_.-]+$"
        }
      },
      "required": [
        "operation",
        "execution_id"
      ]
    },
    {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "operation": {
          "const": "docker_start"
        },
        "integration_id": {
          "type": "string",
          "minLength": 1,
          "maxLength": 64,
          "pattern": "^[A-Za-z0-9_.-]+$"
        }
      },
      "required": [
        "operation",
        "integration_id"
      ]
    },
    {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "operation": {
          "const": "operation"
        },
        "request": {
          "oneOf": [
            {
              "type": "object",
              "additionalProperties": false,
              "properties": {
                "operation": {
                  "const": "workspace_cleanup"
                },
                "workspace_id": {
                  "type": "string",
                  "minLength": 1,
                  "maxLength": 64,
                  "pattern": "^[A-Za-z0-9_.-]+$"
                },
                "quiescence_acknowledged": {
                  "type": "boolean"
                }
              },
              "required": [
                "operation",
                "workspace_id",
                "quiescence_acknowledged"
              ]
            },
            {
              "type": "object",
              "additionalProperties": false,
              "properties": {
                "operation": {
                  "const": "worktree_create"
                },
                "source_workspace_id": {
                  "type": "string",
                  "minLength": 1,
                  "maxLength": 64,
                  "pattern": "^[A-Za-z0-9_.-]+$"
                },
                "destination": {
                  "type": "string",
                  "minLength": 3,
                  "maxLength": 32700
                },
                "branch": {
                  "type": "string",
                  "minLength": 1,
                  "maxLength": 128
                },
                "integration_id": {
                  "anyOf": [
                    {
                      "type": "string",
                      "minLength": 1,
                      "maxLength": 64,
                      "pattern": "^[A-Za-z0-9_.-]+$"
                    },
                    {
                      "type": "null"
                    }
                  ]
                }
              },
              "required": [
                "operation",
                "source_workspace_id",
                "destination",
                "branch"
              ]
            },
            {
              "type": "object",
              "additionalProperties": false,
              "properties": {
                "operation": {
                  "const": "secret_rotate"
                },
                "resource_id": {
                  "type": "string",
                  "minLength": 1,
                  "maxLength": 64,
                  "pattern": "^[A-Za-z0-9_.-]+$"
                }
              },
              "required": [
                "operation",
                "resource_id"
              ]
            },
            {
              "type": "object",
              "additionalProperties": false,
              "properties": {
                "operation": {
                  "const": "secret_revoke"
                },
                "resource_id": {
                  "type": "string",
                  "minLength": 1,
                  "maxLength": 64,
                  "pattern": "^[A-Za-z0-9_.-]+$"
                }
              },
              "required": [
                "operation",
                "resource_id"
              ]
            },
            {
              "type": "object",
              "additionalProperties": false,
              "properties": {
                "operation": {
                  "const": "journal_archive"
                },
                "before": {
                  "type": "integer",
                  "minimum": 0
                },
                "limit": {
                  "type": "integer",
                  "minimum": 1,
                  "maximum": 100
                }
              },
              "required": [
                "operation",
                "before",
                "limit"
              ]
            }
          ]
        }
      },
      "required": [
        "operation",
        "request"
      ]
    }
  ]
}

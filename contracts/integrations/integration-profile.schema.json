{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "Workstation 0.4 integration-profile \u2014 authoring contract; runtime validation is also required",
  "type": "object",
  "additionalProperties": false,
  "properties": {
    "id": {
      "type": "string",
      "minLength": 1,
      "maxLength": 64,
      "pattern": "^[A-Za-z0-9_.-]+$"
    },
    "project_id": {
      "type": "string",
      "minLength": 1,
      "maxLength": 64,
      "pattern": "^[A-Za-z0-9_.-]+$"
    },
    "environment": {
      "type": "string",
      "minLength": 1,
      "maxLength": 64,
      "pattern": "^[A-Za-z0-9_.-]+$"
    },
    "adapter": {
      "type": "string",
      "enum": [
        "codex",
        "claude",
        "cursor_acp",
        "grok_acp",
        "gemini_acp",
        "copilot",
        "open_code",
        "cline",
        "windsurf",
        "doppler",
        "one_password",
        "docker",
        "worktrunk",
        "entire",
        "roo"
      ]
    },
    "executable": {
      "type": "string",
      "minLength": 1,
      "maxLength": 32700
    },
    "executable_sha256": {
      "type": "string",
      "pattern": "^[0-9a-fA-F]{64}$"
    },
    "version_text": {
      "type": "string",
      "minLength": 1,
      "maxLength": 512
    },
    "inherit_env": {
      "type": "array",
      "items": {
        "type": "string",
        "enum": [
          "PATH",
          "USERPROFILE",
          "HOME",
          "APPDATA",
          "LOCALAPPDATA",
          "CODEX_HOME",
          "CLAUDE_CONFIG_DIR",
          "DOCKER_CONFIG",
          "OP_CONFIG_DIR",
          "DOPPLER_CONFIG_DIR",
          "COPILOT_HOME",
          "GEMINI_CLI_HOME",
          "XDG_DATA_HOME",
          "XDG_CONFIG_HOME"
        ]
      },
      "maxItems": 20
    },
    "configuration": {
      "type": "object",
      "maxProperties": 16,
      "propertyNames": {
        "type": "string",
        "enum": [
          "CODEX_HOME",
          "CLAUDE_CONFIG_DIR",
          "DOCKER_CONFIG",
          "OP_CONFIG_DIR",
          "DOPPLER_CONFIG_DIR",
          "COPILOT_HOME",
          "GEMINI_CLI_HOME",
          "XDG_DATA_HOME",
          "XDG_CONFIG_HOME",
          "APPDATA",
          "LOCALAPPDATA"
        ]
      },
      "additionalProperties": {
        "type": "string",
        "minLength": 1,
        "maxLength": 32700
      }
    },
    "authentication": {
      "type": "object",
      "maxProperties": 4,
      "propertyNames": {
        "type": "string",
        "pattern": "^[A-Z_]+$"
      },
      "additionalProperties": {
        "type": "string",
        "minLength": 1,
        "maxLength": 64,
        "pattern": "^[A-Za-z0-9_.-]+$"
      }
    },
    "observed_at": {
      "type": "integer",
      "minimum": 0
    },
    "protocol_revision": {
      "anyOf": [
        {
          "type": "integer",
          "minimum": 1,
          "maximum": 32
        },
        {
          "type": "null"
        }
      ]
    },
    "auth_method": {
      "anyOf": [
        {
          "type": "string",
          "minLength": 1,
          "maxLength": 64,
          "pattern": "^[A-Za-z0-9_.-]+$"
        },
        {
          "type": "null"
        }
      ]
    }
  },
  "required": [
    "id",
    "project_id",
    "environment",
    "adapter",
    "executable",
    "executable_sha256",
    "version_text",
    "inherit_env",
    "configuration",
    "authentication",
    "observed_at"
  ]
}

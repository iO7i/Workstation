{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "v4 typed operation request; authoring schema only, live preconditions are mandatory",
  "oneOf": [
    {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "operation": {
          "const": "workspace_cleanup"
        },
        "workspace_id": {
          "type": "string",
          "minLength": 1,
          "maxLength": 64,
          "pattern": "^[A-Za-z0-9_.-]+$"
        },
        "quiescence_acknowledged": {
          "type": "boolean"
        }
      },
      "required": [
        "operation",
        "workspace_id",
        "quiescence_acknowledged"
      ]
    },
    {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "operation": {
          "const": "worktree_create"
        },
        "source_workspace_id": {
          "type": "string",
          "minLength": 1,
          "maxLength": 64,
          "pattern": "^[A-Za-z0-9_.-]+$"
        },
        "destination": {
          "type": "string",
          "minLength": 3,
          "maxLength": 32700
        },
        "branch": {
          "type": "string",
          "minLength": 1,
          "maxLength": 128
        },
        "integration_id": {
          "anyOf": [
            {
              "type": "string",
              "minLength": 1,
              "maxLength": 64,
              "pattern": "^[A-Za-z0-9_.-]+$"
            },
            {
              "type": "null"
            }
          ]
        }
      },
      "required": [
        "operation",
        "source_workspace_id",
        "destination",
        "branch"
      ]
    },
    {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "operation": {
          "const": "secret_rotate"
        },
        "resource_id": {
          "type": "string",
          "minLength": 1,
          "maxLength": 64,
          "pattern": "^[A-Za-z0-9_.-]+$"
        }
      },
      "required": [
        "operation",
        "resource_id"
      ]
    },
    {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "operation": {
          "const": "secret_revoke"
        },
        "resource_id": {
          "type": "string",
          "minLength": 1,
          "maxLength": 64,
          "pattern": "^[A-Za-z0-9_.-]+$"
        }
      },
      "required": [
        "operation",
        "resource_id"
      ]
    },
    {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "operation": {
          "const": "journal_archive"
        },
        "before": {
          "type": "integer",
          "minimum": 0
        },
        "limit": {
          "type": "integer",
          "minimum": 1,
          "maximum": 100
        }
      },
      "required": [
        "operation",
        "before",
        "limit"
      ]
    }
  ]
}

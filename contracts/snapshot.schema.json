{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "Workstation R0 snapshot",
  "description": "First-slice contract, not the full FS-1.0 product contract.",
  "type": "object",
  "additionalProperties": false,
  "properties": {
    "schema_version": {
      "const": "workstation.r0.v1"
    },
    "run_id": {
      "type": "string"
    },
    "observed_at": {
      "type": "string"
    },
    "installation_id": {
      "type": "string"
    },
    "platform": {
      "type": "string"
    },
    "coverage": {
      "enum": [
        "complete",
        "partial",
        "denied",
        "unsupported",
        "timed_out"
      ]
    },
    "storage": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "properties": {
          "root": {
            "type": "object",
            "additionalProperties": false,
            "properties": {
              "id": {
                "type": "string",
                "pattern": "^[a-z0-9_-]{1,64}$"
              },
              "path": {
                "type": "string"
              },
              "kind": {
                "enum": [
                  "codex",
                  "claude",
                  "cursor",
                  "vscode",
                  "docker",
                  "workspace",
                  "other"
                ]
              }
            },
            "required": [
              "id",
              "path",
              "kind"
            ]
          },
          "observed_at": {
            "type": "string"
          },
          "coverage": {
            "enum": [
              "complete",
              "partial",
              "denied",
              "unsupported",
              "timed_out"
            ]
          },
          "logical_entry_bytes": {
            "type": [
              "integer",
              "null"
            ],
            "minimum": 0
          },
          "allocated_bytes": {
            "type": "null"
          },
          "files": {
            "type": "integer",
            "minimum": 0
          },
          "directories": {
            "type": "integer",
            "minimum": 0
          },
          "visited_entries": {
            "type": "integer",
            "minimum": 0
          },
          "skipped_links_or_placeholders": {
            "type": "integer",
            "minimum": 0
          },
          "io_errors": {
            "type": "integer",
            "minimum": 0
          },
          "notes": {
            "type": "array",
            "items": {
              "type": "string"
            },
            "maxItems": 1000
          },
          "delta_since_previous_complete_bytes": {
            "type": [
              "integer",
              "null"
            ]
          }
        },
        "required": [
          "root",
          "observed_at",
          "coverage",
          "logical_entry_bytes",
          "allocated_bytes",
          "files",
          "directories",
          "visited_entries",
          "skipped_links_or_placeholders",
          "io_errors",
          "notes",
          "delta_since_previous_complete_bytes"
        ]
      },
      "maxItems": 24
    },
    "disks": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "properties": {
          "target": {
            "type": "string"
          },
          "coverage": {
            "enum": [
              "complete",
              "partial",
              "denied",
              "unsupported",
              "timed_out"
            ]
          },
          "available_bytes": {
            "type": [
              "integer",
              "null"
            ],
            "minimum": 0
          },
          "total_bytes": {
            "type": [
              "integer",
              "null"
            ],
            "minimum": 0
          }
        },
        "required": [
          "target",
          "coverage",
          "available_bytes",
          "total_bytes"
        ]
      },
      "maxItems": 4
    },
    "processes": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "observed_at": {
          "type": "string"
        },
        "coverage": {
          "enum": [
            "complete",
            "partial",
            "denied",
            "unsupported",
            "timed_out"
          ]
        },
        "enumerated_count": {
          "type": "integer",
          "minimum": 0
        },
        "selected": {
          "type": "array",
          "items": {
            "type": "object",
            "additionalProperties": false,
            "properties": {
              "pid": {
                "type": "integer",
                "minimum": 0
              },
              "parent_pid_observed": {
                "type": "integer",
                "minimum": 0
              },
              "birth_filetime_100ns": {
                "type": [
                  "integer",
                  "null"
                ],
                "minimum": 0
              },
              "executable_name": {
                "type": "string"
              },
              "working_set_bytes": {
                "type": [
                  "integer",
                  "null"
                ],
                "minimum": 0
              },
              "private_commit_bytes": {
                "type": [
                  "integer",
                  "null"
                ],
                "minimum": 0
              },
              "coverage": {
                "enum": [
                  "complete",
                  "partial",
                  "denied",
                  "unsupported",
                  "timed_out"
                ]
              },
              "ownership": {
                "const": "unknown"
              },
              "disposition": {
                "const": "protected"
              }
            },
            "required": [
              "pid",
              "parent_pid_observed",
              "birth_filetime_100ns",
              "executable_name",
              "working_set_bytes",
              "private_commit_bytes",
              "coverage",
              "ownership",
              "disposition"
            ]
          },
          "maxItems": 1000
        },
        "notes": {
          "type": "array",
          "items": {
            "type": "string"
          },
          "maxItems": 1000
        }
      },
      "required": [
        "observed_at",
        "coverage",
        "enumerated_count",
        "selected",
        "notes"
      ]
    },
    "workspaces": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "properties": {
          "project_id": {
            "type": "string"
          },
          "observed_at": {
            "type": "string"
          },
          "coverage": {
            "enum": [
              "complete",
              "partial",
              "denied",
              "unsupported",
              "timed_out"
            ]
          },
          "worktrees": {
            "type": "array",
            "items": {
              "type": "object",
              "additionalProperties": false,
              "properties": {
                "path": {
                  "type": "string"
                },
                "head": {
                  "type": [
                    "string",
                    "null"
                  ]
                },
                "branch": {
                  "type": [
                    "string",
                    "null"
                  ]
                },
                "detached": {
                  "type": "boolean"
                },
                "bare": {
                  "type": "boolean"
                },
                "locked": {
                  "type": "boolean"
                },
                "prunable": {
                  "type": "boolean"
                },
                "disposition": {
                  "const": "protected"
                },
                "content_coverage": {
                  "const": "unsupported"
                }
              },
              "required": [
                "path",
                "head",
                "branch",
                "detached",
                "bare",
                "locked",
                "prunable",
                "disposition",
                "content_coverage"
              ]
            },
            "maxItems": 200
          },
          "notes": {
            "type": "array",
            "items": {
              "type": "string"
            },
            "maxItems": 1000
          }
        },
        "required": [
          "project_id",
          "observed_at",
          "coverage",
          "worktrees",
          "notes"
        ]
      },
      "maxItems": 20
    },
    "findings": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "properties": {
          "code": {
            "type": "string"
          },
          "severity": {
            "enum": [
              "info",
              "warning",
              "critical"
            ]
          },
          "target_id": {
            "type": [
              "string",
              "null"
            ]
          },
          "explanation": {
            "type": "string"
          },
          "next_action": {
            "type": "string"
          },
          "repair_available": {
            "const": false
          }
        },
        "required": [
          "code",
          "severity",
          "target_id",
          "explanation",
          "next_action",
          "repair_available"
        ]
      },
      "maxItems": 1000
    },
    "not_inspected": {
      "type": "array",
      "items": {
        "type": "string"
      },
      "maxItems": 1000
    },
    "saved": {
      "type": "boolean"
    }
  },
  "required": [
    "schema_version",
    "run_id",
    "observed_at",
    "installation_id",
    "platform",
    "coverage",
    "storage",
    "disks",
    "processes",
    "workspaces",
    "findings",
    "not_inspected",
    "saved"
  ]
}

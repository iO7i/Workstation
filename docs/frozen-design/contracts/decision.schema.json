{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://workstation.invalid/contracts/decision.schema.json",
  "title": "Workstation decision v1",
  "type": "object",
  "properties": {
    "schema_version": {
      "const": "1.0"
    },
    "id": {
      "type": "string",
      "pattern": "^[A-Za-z0-9][A-Za-z0-9._:-]{0,127}$"
    },
    "project_id": {
      "type": "string",
      "pattern": "^[A-Za-z0-9][A-Za-z0-9._:-]{0,127}$"
    },
    "topic_key": {
      "type": "string",
      "pattern": "^[A-Za-z0-9][A-Za-z0-9._:-]{0,127}$"
    },
    "scope": {
      "type": "object",
      "properties": {
        "environment_id": {
          "type": [
            "string",
            "null"
          ]
        },
        "component": {
          "type": [
            "string",
            "null"
          ]
        },
        "branch": {
          "type": [
            "string",
            "null"
          ]
        }
      },
      "required": [
        "environment_id",
        "component",
        "branch"
      ],
      "additionalProperties": false
    },
    "status": {
      "type": "string",
      "enum": [
        "proposed",
        "accepted",
        "rejected",
        "withdrawn",
        "superseded"
      ]
    },
    "statement": {
      "type": "string",
      "minLength": 1,
      "maxLength": 4096
    },
    "rationale": {
      "type": "string",
      "minLength": 1,
      "maxLength": 4096
    },
    "alternatives": {
      "type": "array",
      "items": {
        "type": "string",
        "minLength": 1,
        "maxLength": 4096
      },
      "maxItems": 256
    },
    "consequences": {
      "type": "array",
      "items": {
        "type": "string",
        "minLength": 1,
        "maxLength": 4096
      },
      "maxItems": 256
    },
    "source_ids": {
      "type": "array",
      "items": {
        "type": "string",
        "pattern": "^[A-Za-z0-9][A-Za-z0-9._:-]{0,127}$"
      },
      "maxItems": 256
    },
    "predecessor_id": {
      "type": [
        "string",
        "null"
      ]
    },
    "effective_at": {
      "type": "string",
      "format": "date-time"
    },
    "recorded_at": {
      "type": "string",
      "format": "date-time"
    },
    "author": {
      "type": "string",
      "minLength": 1,
      "maxLength": 4096
    },
    "approval_id": {
      "type": [
        "string",
        "null"
      ]
    }
  },
  "required": [
    "schema_version",
    "id",
    "project_id",
    "topic_key",
    "scope",
    "status",
    "statement",
    "rationale",
    "alternatives",
    "consequences",
    "source_ids",
    "predecessor_id",
    "effective_at",
    "recorded_at",
    "author",
    "approval_id"
  ],
  "additionalProperties": false
}

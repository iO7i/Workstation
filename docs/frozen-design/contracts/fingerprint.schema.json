{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://workstation.invalid/contracts/fingerprint.schema.json",
  "title": "Workstation fingerprint v1",
  "type": "object",
  "properties": {
    "schema_version": {
      "const": "1.0"
    },
    "id": {
      "type": "string",
      "pattern": "^[A-Za-z0-9][A-Za-z0-9._:-]{0,127}$"
    },
    "version": {
      "type": "string",
      "minLength": 1,
      "maxLength": 4096
    },
    "platform": {
      "const": "windows"
    },
    "adapter_id": {
      "type": "string",
      "pattern": "^[A-Za-z0-9][A-Za-z0-9._:-]{0,127}$"
    },
    "tested_versions": {
      "type": "array",
      "items": {
        "type": "string",
        "minLength": 1,
        "maxLength": 4096
      },
      "maxItems": 256
    },
    "evidence_all": {
      "type": "array",
      "items": {
        "type": "string",
        "pattern": "^[A-Za-z0-9][A-Za-z0-9._:-]{0,127}$"
      },
      "maxItems": 256
    },
    "protect_if": {
      "type": "array",
      "items": {
        "type": "string",
        "pattern": "^[A-Za-z0-9][A-Za-z0-9._:-]{0,127}$"
      },
      "maxItems": 256
    },
    "severity": {
      "type": "string",
      "enum": [
        "info",
        "warning",
        "critical"
      ]
    },
    "diagnosis": {
      "type": "string",
      "minLength": 1,
      "maxLength": 4096
    },
    "repair_recipe_id": {
      "type": [
        "string",
        "null"
      ]
    },
    "source_ids": {
      "type": "array",
      "items": {
        "type": "string",
        "pattern": "^[A-Za-z0-9][A-Za-z0-9._:-]{0,127}$"
      },
      "maxItems": 256
    },
    "fixture_ids": {
      "type": "array",
      "items": {
        "type": "string",
        "pattern": "^[A-Za-z0-9][A-Za-z0-9._:-]{0,127}$"
      },
      "maxItems": 256
    },
    "unknown_evidence_policy": {
      "const": "diagnostic_only"
    }
  },
  "required": [
    "schema_version",
    "id",
    "version",
    "platform",
    "adapter_id",
    "tested_versions",
    "evidence_all",
    "protect_if",
    "severity",
    "diagnosis",
    "repair_recipe_id",
    "source_ids",
    "fixture_ids",
    "unknown_evidence_policy"
  ],
  "additionalProperties": false
}

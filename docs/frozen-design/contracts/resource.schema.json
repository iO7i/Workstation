{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://workstation.invalid/contracts/resource.schema.json",
  "title": "Workstation resource v1",
  "type": "object",
  "properties": {
    "schema_version": {
      "const": "1.0"
    },
    "id": {
      "type": "string",
      "pattern": "^[A-Za-z0-9][A-Za-z0-9._:-]{0,127}$"
    },
    "project_id": {
      "type": "string",
      "pattern": "^[A-Za-z0-9][A-Za-z0-9._:-]{0,127}$"
    },
    "environment_id": {
      "type": "string",
      "pattern": "^[A-Za-z0-9][A-Za-z0-9._:-]{0,127}$"
    },
    "kind": {
      "type": "string",
      "enum": [
        "service",
        "endpoint",
        "repository",
        "deployment",
        "database",
        "runbook",
        "provider_object"
      ]
    },
    "label": {
      "type": "string",
      "minLength": 1,
      "maxLength": 4096
    },
    "provider": {
      "type": [
        "string",
        "null"
      ]
    },
    "provider_object_id": {
      "type": [
        "string",
        "null"
      ]
    },
    "endpoint": {
      "type": [
        "string",
        "null"
      ]
    },
    "secret_reference_ids": {
      "type": "array",
      "items": {
        "type": "string",
        "pattern": "^[A-Za-z0-9][A-Za-z0-9._:-]{0,127}$"
      },
      "maxItems": 256
    },
    "authority": {
      "type": "string",
      "enum": [
        "proposed",
        "human_accepted",
        "provider_observed",
        "conflict",
        "revoked"
      ]
    },
    "source_ids": {
      "type": "array",
      "items": {
        "type": "string",
        "pattern": "^[A-Za-z0-9][A-Za-z0-9._:-]{0,127}$"
      },
      "maxItems": 256
    },
    "last_verification": {
      "anyOf": [
        {
          "type": "null"
        },
        {
          "type": "object",
          "properties": {
            "kind": {
              "type": "string",
              "enum": [
                "syntax",
                "dns",
                "tls",
                "health_response",
                "provider_identity",
                "human_confirmation"
              ]
            },
            "result": {
              "type": "string",
              "enum": [
                "passed",
                "failed",
                "unknown",
                "blocked"
              ]
            },
            "observed_at": {
              "type": "string",
              "format": "date-time"
            }
          },
          "required": [
            "kind",
            "result",
            "observed_at"
          ],
          "additionalProperties": false
        }
      ]
    }
  },
  "required": [
    "schema_version",
    "id",
    "project_id",
    "environment_id",
    "kind",
    "label",
    "provider",
    "provider_object_id",
    "endpoint",
    "secret_reference_ids",
    "authority",
    "source_ids",
    "last_verification"
  ],
  "additionalProperties": false
}

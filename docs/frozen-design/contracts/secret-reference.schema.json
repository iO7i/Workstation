{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://workstation.invalid/contracts/secret-reference.schema.json",
  "title": "Workstation secret-reference v1",
  "type": "object",
  "properties": {
    "id": {
      "type": "string",
      "pattern": "^[A-Za-z0-9][A-Za-z0-9._:-]{0,127}$"
    },
    "provider": {
      "type": "string",
      "enum": [
        "local_dpapi",
        "doppler",
        "onepassword",
        "infisical",
        "bitwarden"
      ]
    },
    "connection_id": {
      "type": "string",
      "pattern": "^[A-Za-z0-9][A-Za-z0-9._:-]{0,127}$"
    },
    "project_id": {
      "type": "string",
      "pattern": "^[A-Za-z0-9][A-Za-z0-9._:-]{0,127}$"
    },
    "environment_id": {
      "type": "string",
      "pattern": "^[A-Za-z0-9][A-Za-z0-9._:-]{0,127}$"
    },
    "locator": {
      "type": "object",
      "properties": {
        "provider_project": {
          "type": "string",
          "minLength": 1,
          "maxLength": 4096
        },
        "provider_environment": {
          "type": "string",
          "minLength": 1,
          "maxLength": 4096
        },
        "item": {
          "type": "string",
          "minLength": 1,
          "maxLength": 4096
        },
        "field": {
          "type": "string",
          "minLength": 1,
          "maxLength": 4096
        }
      },
      "required": [
        "item"
      ],
      "additionalProperties": false
    },
    "expose_to_agent": {
      "const": false
    }
  },
  "required": [
    "id",
    "provider",
    "connection_id",
    "project_id",
    "environment_id",
    "locator",
    "expose_to_agent"
  ],
  "additionalProperties": false
}

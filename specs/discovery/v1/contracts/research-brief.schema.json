{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "FS-1.0-D1 research-brief: R4 design contract",
  "type": "object",
  "additionalProperties": false,
  "properties": {
    "schema_version": {
      "const": 1
    },
    "purpose": {
      "const": "find_relevant_resources"
    },
    "needs": {
      "type": "array",
      "items": {
        "type": "string",
        "enum": [
          "parallel_work",
          "interface_review",
          "accessibility_review",
          "reproducible_evaluation",
          "decision_context",
          "credential_location",
          "runtime_recovery",
          "storage_attribution"
        ]
      },
      "maxItems": 8,
      "minItems": 1,
      "uniqueItems": true
    },
    "platform": {
      "type": "string",
      "enum": [
        "windows",
        "macos",
        "linux"
      ]
    },
    "constraints": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "free_only": {
          "type": "boolean"
        },
        "local_only": {
          "type": "boolean"
        },
        "allow_network_dependency": {
          "type": "boolean"
        }
      },
      "required": [
        "free_only",
        "local_only",
        "allow_network_dependency"
      ]
    },
    "max_candidates": {
      "type": "integer",
      "minimum": 1,
      "maximum": 10
    },
    "allowed_kinds": {
      "type": "array",
      "items": {
        "type": "string",
        "enum": [
          "existing_capability",
          "tool",
          "integration",
          "skill",
          "workflow",
          "documentation",
          "reference_implementation",
          "dataset",
          "benchmark"
        ]
      },
      "maxItems": 9,
      "minItems": 1,
      "uniqueItems": true
    }
  },
  "required": [
    "schema_version",
    "purpose",
    "needs",
    "platform",
    "constraints",
    "max_candidates",
    "allowed_kinds"
  ]
}
